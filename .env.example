# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=localhost

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Image Provider Configuration
# Options: "mock", "gemini"
# - mock: Generates placeholder images locally (no API calls) - DEFAULT
#   (Gemini image models are paid-only as of 2026; see DECISIONS.md)
# - gemini: Uses Gemini image generation (real Nano Banana calls, billing required)
IMAGE_PROVIDER=mock

# Gemini Image Configuration (Nano Banana family)
# GEMINI_IMAGE_MODEL and GEMINI_IMAGE_MODEL_ALTERNATIVE are configured in backend/app/config.py
# MOCK_IMAGE_OUTPUT_DIR only matters when IMAGE_PROVIDER=mock

# Image Output Directories
MOCK_IMAGE_OUTPUT_DIR=data/mock_images

# Frontend Configuration (create frontend/.env.local with this)
NEXT_PUBLIC_API_URL=http://localhost:8000